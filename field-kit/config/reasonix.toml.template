# reasonix project config (rs-iot field) - template, regenerated by start-rsiot.bat
# Placeholders: __ROOT__ -> field root (forward slashes), __JWT__ -> rs-iot login token (fresh each start)
# serve snapshots config at startup: edits require reasonix service restart (warden UI).
# Pitfalls: TOML strings must use forward slashes; [serve] has no addr key (use -addr flag).

[serve]
auth_mode = "token"
token     = "test-serve-token-123"   # must equal gateway.toml serve_token

[[plugins]]
name    = "rsiot"
command = "__ROOT__/bin/rsiot-mcp.exe"
args    = []
env     = { RSIOT_BASE = "http://127.0.0.1:8790", RSIOT_JWT = "__JWT__" }

[sandbox]
workspace_root = "__ROOT__/work"
allow_write    = ["__ROOT__/scripts"]
forbid_read    = ["__ROOT__/data"]
bash           = "off"
network        = true
